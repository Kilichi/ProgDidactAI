# mongodb para la entrega. file permite una demostración local sin MongoDB.
DATA_DRIVER=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=progdidactai
DATA_DIR=./data
# local, gemini o groq. Las claves nunca se envían al navegador.
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHROMIUM_PATH=/usr/bin/chromium
PDFTOTEXT_PATH=pdftotext
LIBREOFFICE_PATH=libreoffice
PDFTOHTML_PATH=pdftohtml
PYTHON_PATH=python3
